# ---- App ----
# Secret untuk signed session cookie + enkripsi token. GANTI dengan random panjang!
SECRET_KEY=change-me-to-a-long-random-string

# Admin awal (operator yang login ke app)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me

# Mode mock: true = simpan file lokal (tanpa Google). false = pakai Google Drive asli.
DRIVE_MOCK=true

# ---- Google OAuth (isi setelah buat di Google Cloud Console) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/callback

# ---- Hosting ----
PORT=8000
